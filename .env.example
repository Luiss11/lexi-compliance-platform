# ---------- Base de datos ----------
POSTGRES_USER=lexi
POSTGRES_PASSWORD=lexi_dev
POSTGRES_DB=lexi
DATABASE_URL=postgresql://lexi:lexi_dev@localhost:5432/lexi

# ---------- Vector store ----------
VECTOR_BACKEND=qdrant            # qdrant | pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lexi_chunks

# ---------- IA ----------
LLM_PROVIDER=openai              # openai | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
RAG_COSINE_CUTOFF=0.75
RAG_TOP_K=8
# Tope de uso de IA (controla el gasto): por usuario cada hora y por organización cada día
# AI_USER_HOURLY_LIMIT=30
# AI_TENANT_DAILY_LIMIT=200

# ---------- Seguridad ----------
# OBLIGATORIO: la API no arranca con este valor de ejemplo ni con menos de 32 caracteres.
# Genera uno: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Solo desarrollo local; nunca en un servidor real:
# ALLOW_INSECURE_JWT_SECRET=true
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
# Freno a intentos fallidos de login: por cuenta y por IP, en una ventana de 15 min
# LOGIN_MAX_FAILURES=5
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_WINDOW_SECONDS=900

# ---------- Archivos ----------
STORAGE_DIR=./storage

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
