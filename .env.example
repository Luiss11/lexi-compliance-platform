# ---------- Base de datos ----------
POSTGRES_USER=lexi
POSTGRES_PASSWORD=lexi_dev
POSTGRES_DB=lexi
DATABASE_URL=postgresql://lexi:lexi_dev@localhost:5432/lexi

# ---------- Vector store ----------
VECTOR_BACKEND=qdrant            # qdrant | pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lexi_chunks

# ---------- IA ----------
LLM_PROVIDER=openai              # openai | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
RAG_COSINE_CUTOFF=0.75
RAG_TOP_K=8

# ---------- Seguridad ----------
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# ---------- Archivos ----------
STORAGE_DIR=./storage

# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
