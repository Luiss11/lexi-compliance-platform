# Ajustes de PRODUCCIÓN. Copia este archivo a .env.prod en el servidor y rellénalo:
#     cp .env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod nunca se sube al repositorio (está en .gitignore).
#
# Genera cada secreto con:
#     openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# ---------- Dominio y HTTPS ----------
# El dominio debe apuntar (registro A) a la IP del servidor ANTES de arrancar.
DOMAIN=cumplimiento.ejemplo.mx
# Let's Encrypt avisa a este correo si un certificado está por vencer sin renovarse
ACME_EMAIL=ti@ejemplo.mx

# ---------- Base de datos ----------
# Contraseña propia de este servidor, distinta a la de desarrollo (lexi_dev).
# Solo letras y números: va dentro de una URL de conexión.
POSTGRES_USER=lexi
POSTGRES_PASSWORD=
POSTGRES_DB=lexi

# ---------- Seguridad ----------
# Obligatorio, al menos 32 caracteres. Si lo cambias, todas las sesiones se cierran.
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# ---------- IA ----------
# Con LLM_PROVIDER=openai la API no arranca sin OPENAI_API_KEY.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Tope de gasto: llamadas por usuario cada hora y por organización cada día
AI_USER_HOURLY_LIMIT=30
AI_TENANT_DAILY_LIMIT=200

# ---------- Vector store ----------
VECTOR_BACKEND=qdrant
QDRANT_COLLECTION=lexi_chunks

# ---------- Respaldos (scripts/backup.sh) ----------
# Carpeta del servidor donde se guardan las copias nocturnas y cuántos días se conservan
BACKUP_DIR=/var/backups/lexi
BACKUP_KEEP_DAYS=14
# Opcional pero muy recomendado: copia fuera del servidor con rclone (ver la guía).
# Ejemplo: BACKUP_REMOTE=b2:lexi-respaldos
BACKUP_REMOTE=
