# Imagen de producción de la web (la de desarrollo es Dockerfile, con recarga en caliente).
# Tres etapas: dependencias → compilación → imagen final mínima con el servidor standalone.
# La etapa "migrator" se usa como contenedor de un solo uso para aplicar migraciones Prisma.

FROM node:20-bookworm-slim AS deps
RUN apt-get update -y && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY prisma ./prisma
RUN npx prisma generate

# Aplica las migraciones pendientes y termina (servicio "migrate" de docker-compose.prod.yml)
FROM deps AS migrator
CMD ["npx", "prisma", "migrate", "deploy"]

FROM deps AS builder
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
# public/ puede no existir en un clon limpio (git no guarda carpetas vacías)
RUN mkdir -p public && npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
