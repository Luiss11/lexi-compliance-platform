// Fuente única del modelo de datos (ADR-0002) · TASK-12
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMPLIANCE
  OPERATOR
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  INDEXED
  NEEDS_REVIEW
  ERROR
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  ALTA
  MEDIA
  BAJA
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sector    String
  createdAt DateTime   @default(now())
  users     User[]
  documents Document[]
  tasks     Task[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())
  tasks        Task[]   @relation("assignee")
  evidence     EvidenceFile[]

  @@unique([tenantId, email])
  @@map("users")
}

model Document {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  category    String
  status      DocumentStatus @default(UPLOADED)
  pages       Int?
  chunks      Int?
  sha256      String
  storagePath String
  uploadedBy  String?
  createdAt   DateTime       @default(now())
  tasks       Task[]

  @@index([tenantId])
  @@map("documents")
}

model Task {
  id           String         @id @default(cuid())
  code         String
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId   String?
  document     Document?      @relation(fields: [documentId], references: [id])
  assigneeId   String?
  assignee     User?          @relation("assignee", fields: [assigneeId], references: [id])
  title        String
  description  String?
  status       TaskStatus     @default(BACKLOG)
  priority     Priority       @default(MEDIA)
  dueDate      DateTime?
  citation     String?
  suggestedByAi Boolean       @default(false)
  createdAt    DateTime       @default(now())
  evidence     EvidenceFile[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("tasks")
}

model EvidenceFile {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  filename    String
  mimeType    String
  sizeBytes   Int
  sha256      String
  aiVerdict   String?
  createdAt   DateTime @default(now())

  @@index([sha256])
  @@map("evidence_files")
}
