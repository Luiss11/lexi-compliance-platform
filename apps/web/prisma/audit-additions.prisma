// Pega estos dos modelos AL FINAL de apps/web/prisma/schema.prisma (no cambies nada más).
// Después: docker compose exec web npx prisma db push

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model EvidenceReview {
  id         String   @id @default(cuid())
  evidenceId String
  tenantId   String
  verdict    String
  summary    String
  issues     Json?
  model      String
  createdAt  DateTime @default(now())

  @@index([evidenceId])
  @@map("evidence_reviews")
}
